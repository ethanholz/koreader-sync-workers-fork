{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "koreader-sync",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "koreader-sync",
      "database_id": "replace-with-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DISABLE_USER_REGISTRATION": "false"
  },
  "secrets": {
    "required": [
      "PASSWORD_SALT"
    ]
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
